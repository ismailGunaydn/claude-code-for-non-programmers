{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./<ORIGINALS-FOLDER>/**)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
